{
  "name": "waqtu",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @waqtu/web dev",
    "dev:api": "bun --filter @waqtu/api dev",
    "build": "bun --filter @waqtu/web build",
    "dev:mobile": "bun --filter @waqtu/mobile start",
    "deploy:web": "bun --filter @waqtu/web deploy",
    "deploy:api": "bun --filter @waqtu/api deploy",
    "typecheck": "bun --filter @waqtu/web typecheck && bun --filter @waqtu/api typecheck && bun --filter @waqtu/core typecheck && bun --filter @waqtu/mobile typecheck",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "test": "bun --filter @waqtu/core test"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  }
}
