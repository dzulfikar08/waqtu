# Waqtu release automation.
# Install fastlane:  `brew install fastlane`
# App Store Connect API key (recommended, non-interactive uploads):
#   1. ASC -> Users and Access -> Integrations -> App Store Connect API -> Generate (Admin)
#   2. Save the .p8, set env: export APP_STORE_CONNECT_API_KEY_PATH=/path/AuthKey_ABC.p8
#      export APP_STORE_CONNECT_API_KEY_ID=ABC...      export APP_STORE_CONNECT_API_KEY_ISSUER_ID=...

default_platform(:ios)

# ---- shared helpers --------------------------------------------------------

# Builds an API key from env if provided, else nil (fastlane falls back to apple_id auth).
def asc_api_key
  return nil unless ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  app_store_connect_api_key(
    key_id:     ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id:  ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    in_house:   false
  )
end

# ---- iOS + watchOS ---------------------------------------------------------

desc "Build waqtu-ios and upload to TestFlight"
lane :ios_beta do
  build_ios_app(
    scheme: "waqtu-ios",
    workspace: nil,
    project: "waqt.xcodeproj",
    export_method: "app-store",
    include_bitcode: false,
    skip_package_pkg_installation: true
  )
  pilot(
    api_key: asc_api_key,
    app_identifier: "dat.waqtu.ios",
    skip_waiting_for_build_processing: true
  )
end

desc "Push App Store metadata (from fastlane/metadata/ios) without a new binary"
lane :ios_metadata do
  deliver(
    api_key: asc_api_key,
    app_identifier: "dat.waqtu.ios",
    metadata_only: true,
    force: true,                 # skip HTML preview confirmation
    skip_screenshots: true,
    skip_binary_upload: true,
    precheck_include_in_app_purchases: false
  )
end

desc "Capture iOS screenshots (requires snapshot() calls in a UITest — see README)"
lane :ios_screenshots do
  snapshot(
    project: "waqt.xcodeproj",
    scheme: "waqtu-ios",          # change to an iOS UITest scheme once added
    devices: ["iPhone 15 Pro Max"],
    languages: ["en-US"],
    output_directory: "fastlane/screenshots/ios",
    clear_previous_screenshots: true
  )
end

# ---- Mac App Store ---------------------------------------------------------

desc "Build waqtu-mas and upload to TestFlight (Mac App Store)"
lane :mas_beta do
  build_app(
    scheme: "waqtu-mas",
    project: "waqt.xcodeproj",
    export_method: "app-store",
    include_bitcode: false,
    export_xcargs: "-allowProvisioningUpdates"
  )
  deliver(
    api_key: asc_api_key,
    app_identifier: "dat.waqtu",
    app_platform: "mac",
    metadata_only: false,
    skip_screenshots: true,
    force: true,
    precheck_include_in_app_purchases: false
  )
end

desc "Push MAS metadata (from fastlane/metadata/macos)"
lane :mas_metadata do
  deliver(
    api_key: asc_api_key,
    app_identifier: "dat.waqtu",
    app_platform: "mac",
    metadata_only: true,
    skip_screenshots: true,
    skip_binary_upload: true,
    force: true,
    precheck_include_in_app_purchases: false
  )
end

# ---- versioning / release --------------------------------------------------

desc "Tag current HEAD as a release (pass version: e.g. fastlane tag version:2.0.0)"
lane :tag do |options|
  version = options[:version]
  UI.user_error!("Pass version:, e.g. `fastlane tag version:2.0.0`") unless version
  sh "git tag -a v#{version} -m 'Release #{version}'"
  sh "git push --tags"
  UI.success("Tagged v#{version}")
end

error do |lane, _exception|
  UI.important("Lane #{lane} failed. If signing: confirm team F6Q6UFUK69 + distribution cert + provisioning in Xcode, or set APP_STORE_CONNECT_API_KEY_* env.")
end
