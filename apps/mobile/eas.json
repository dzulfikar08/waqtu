    },
    "production": {
      "channel": "production",
      "credentialsSource": "local",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "bun": "1.4.4"
    }
  },
  "submit": {
    "production": {}
  }
