{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "bun": "1.4.4",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getwaqtu.com"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "bun": "1.4.4",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getwaqtu.com"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "local",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "bun": "1.4.4",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getwaqtu.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826628861"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
