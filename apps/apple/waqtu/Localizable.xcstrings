    "Waqtu account" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Waqtu"
          }
        }
      }
    },
    "Waqtu shows prayer times right in your Mac's menu bar, with countdown to the next prayer." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waqtu menampilkan waktu sholat langsung di bilah menu Mac, lengkap dengan hitung mundur ke sholat berikutnya."
          }
        }
      }
    },
    "Waqtu will create daily prayer blocks in your calendar so you appear busy during prayer times. Events are recreated every day to match changing prayer times." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waqtu akan membuat blok sholat harian di kalendermu agar kamu tampak sibuk selama waktu sholat. Acara dibuat ulang setiap hari mengikuti perubahan waktu sholat."
          }
        }
      }
    },
    "We use your Mac's location to calculate accurate prayer times. Your location never leaves your device — no tracking, no servers." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi Mac dipakai untuk menghitung waktu sholat yang akurat. Lokasimu tidak pernah keluar dari perangkat — tanpa pelacakan, tanpa server."
          }
        }
      }
    },
    "Welcome to Waqtu" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat Datang di Waqtu"
          }
        }
      }
    },
    "You tapped \"I am going to pray\" for %@ but your Mac is still active. Don't forget your commitment." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menekan \"Saya akan sholat\" untuk %@, tetapi Mac-mu masih aktif. Jangan lupa niatmu."
          }
        }
      }
    },
    "Your Slack status will change to \"Praying\" during prayer times and auto-clear when the prayer block ends." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status Slack-mu otomatis berubah selama waktu sholat dan kembali seperti semula saat blok sholat selesai."
          }
        }
      }
    },
    "Your checklist is empty. Add practices in Settings." : {
