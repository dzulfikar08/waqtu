---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  keywords?: string;
  /** Page language. Drives <html lang>, og:locale and the default Mac copy. */
  lang?: "en" | "id";
  /** hreflang alternates (paths), emitted as <link rel="alternate">. */
  alternates?: { hreflang: string; href: string }[];
  /** Set false on pages that ship their own JSON-LD through the "head" slot. */
  defaultJsonLd?: boolean;
}

const siteUrl = "https://getwaqtu.com";

const {
  title = "Waqtu — Prayer Times in Your Menu Bar for Mac",
  description = "Prayer times in your Mac menu bar. Waqtu blocks your calendar during salah and shows you as busy in Teams and Slack. No ads, no tracking. macOS 12+.",
  canonical = "/",
  ogTitle,
  ogDescription,
  ogImage = "/og-image.webp",
  ogImageAlt = "Waqtu — Prayer times in your Mac menu bar",
  keywords = "prayer times mac, mac menu bar prayer times, best prayer times app mac, prayer times app macos, salah reminder mac, menu bar prayer times mac, muslim productivity app, calendar prayer blocks, teams busy prayer, slack status prayer, waqtu",
  lang = "en",
  alternates = [],
  defaultJsonLd = true,
} = Astro.props;

const canonicalUrl = new URL(canonical, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, siteUrl).href} />
      ))
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Waqtu" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Waqtu" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@waqtuapp" />
    <meta name="twitter:creator" content="@waqtuapp" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#f6f5f1" />

    {defaultJsonLd && <JsonLd />}
    <slot name="head" />

    <script
      defer
      src="https://assets.onedollarstats.com/stonks.js"
      is:inline
    ></script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
