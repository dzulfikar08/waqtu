---
import BaseLayout from "../layouts/BaseLayout.astro";
import BackLink from "./BackLink.astro";
import {
  LEGAL_UPDATED,
  legalNav,
  legalPaths,
  privacy,
  support,
  terms,
  type LegalLocale,
} from "../i18n/legal";
import { SUPPORT_EMAIL } from "../i18n/landing";

export interface Props {
  kind: "privacy" | "terms" | "support";
  locale: LegalLocale;
}

const { kind, locale } = Astro.props;
const nav = legalNav[locale];
const paths = legalPaths[locale];
const other = legalPaths[nav.switchLang];

const doc = kind === "privacy" ? privacy[locale] : kind === "terms" ? terms[locale] : null;
const help = kind === "support" ? support[locale] : null;
const title = (doc ?? help)!.title;
const description = (doc ?? help)!.description;

const updated = new Date(`${LEGAL_UPDATED}T00:00:00Z`).toLocaleDateString(
  locale === "id" ? "id-ID" : "en-US",
  { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
);

const links = [
  { href: paths.privacy, label: nav.privacy, current: kind === "privacy" },
  { href: paths.terms, label: nav.terms, current: kind === "terms" },
  { href: paths.support, label: nav.support, current: kind === "support" },
];
---

<BaseLayout
  title={`${title} | Waqtu`}
  description={description}
  canonical={paths[kind]}
  lang={locale}
  alternates={[
    { hreflang: "id", href: legalPaths.id[kind] },
    { hreflang: "en", href: legalPaths.en[kind] },
    { hreflang: "x-default", href: legalPaths.id[kind] },
  ]}
  defaultJsonLd={false}
>
  <div class="relative z-10 min-h-screen px-6 py-16 sm:px-10 md:px-14 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="flex items-start justify-between gap-4">
        <BackLink href={paths.home} label={nav.back} />
        <a
          href={other[kind]}
          hreflang={nav.switchLang}
          lang={nav.switchLang}
          class="text-sm text-[var(--waqtu-muted)] transition-colors hover:text-[var(--waqtu-text)]"
        >
          {nav.switchLabel}
        </a>
      </div>
      <h1
        class="font-display mb-8 text-3xl font-semibold tracking-tight text-[var(--waqtu-text)] sm:text-4xl"
      >
        {title}
      </h1>

      <div class="prose-waqtu">
        {
          doc && (
            <>
              <p class="text-[var(--waqtu-text)]">
                {doc.updatedLabel}: <time datetime={LEGAL_UPDATED}>{updated}</time>
              </p>
              {doc.intro.map((p) => (
                <p set:html={p} />
              ))}
              {doc.sections.map((s) => (
                <section>
                  <h2>{s.heading}</h2>
                  {s.paragraphs?.map((p) => <p set:html={p} />)}
                  {s.items && (
                    <ul>
                      {s.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  )}
                </section>
              ))}
            </>
          )
        }
        {
          help && (
            <>
              <p>{help.intro}</p>
              <section>
                <h2>{help.contactHeading}</h2>
                <p>{help.contactBody}</p>
                <p>
                  <a href={`mailto:${SUPPORT_EMAIL}`}>{help.contactCta}: {SUPPORT_EMAIL}</a>
                </p>
              </section>
              <section>
                <h2>{help.faqHeading}</h2>
                <div class="faq-list">
                  {help.faq.map((item) => (
                    <details>
                      <summary>{item.question}</summary>
                      <p set:html={item.answer} />
                    </details>
                  ))}
                </div>
              </section>
            </>
          )
        }
      </div>

      <nav
        aria-label="Waqtu"
        class="mt-14 flex flex-wrap gap-x-6 gap-y-2 border-t border-[var(--waqtu-border)] pt-6 text-sm"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              class:list={[
                "transition-colors hover:text-[var(--waqtu-text)]",
                link.current
                  ? "font-medium text-[var(--waqtu-text)]"
                  : "text-[var(--waqtu-muted)]",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .prose-waqtu .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prose-waqtu .faq-list details {
    border-bottom: 1px solid var(--waqtu-border);
    padding: 0.75rem 0;
  }
  .prose-waqtu .faq-list summary {
    cursor: pointer;
    color: var(--waqtu-text);
    font-weight: 500;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .prose-waqtu .faq-list details p {
    margin-top: 0.5rem;
  }
</style>
