---
// Structured data for Waqtu — SoftwareApplication, Organization, FAQPage, WebSite.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Waqtu",
      operatingSystem: "macOS",
      applicationCategory: "LifestyleApplication",
      description:
        "Prayer times in your Mac menu bar. Calendar blocks during prayers. Teams shows you as busy.",
      // Waqtu Premium is a store subscription; the app itself is free to download.
      offers: [
        {
          "@type": "Offer",
          name: "Waqtu Premium (monthly)",
          price: "29000",
          priceCurrency: "IDR",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: "29000",
            priceCurrency: "IDR",
            referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
          },
          availability: "https://schema.org/InStock",
        },
        {
          "@type": "Offer",
          name: "Waqtu Premium (yearly)",
          price: "249000",
          priceCurrency: "IDR",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: "249000",
            priceCurrency: "IDR",
            referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "ANN" },
          },
          availability: "https://schema.org/InStock",
        },
      ],
      author: { "@type": "Person", name: "Dzulfikar Ats Tsauri", url: "https://getwaqtu.com" },
      publisher: { "@id": "https://getwaqtu.com/#organization" },
    },
    {
      "@type": "Organization",
      "@id": "https://getwaqtu.com/#organization",
      name: "Waqtu",
      url: "https://getwaqtu.com",
      logo: "https://getwaqtu.com/og-image.webp",
      founder: { "@type": "Person", name: "Dzulfikar Ats Tsauri" },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which macOS versions are supported?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "macOS 12 (Monterey) and later. Both Intel and Apple Silicon Macs are supported.",
          },
        },
        {
          "@type": "Question",
          name: "How does calendar protection work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Waqtu creates events in your default calendar app, or syncs with Exchange/iCloud calendars. These events show you as 'busy' during prayer times.",
          },
        },
        {
          "@type": "Question",
          name: "Does Waqtu work offline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Prayer times are calculated locally on your Mac. Internet is only needed for the initial download and updates.",
          },
        },
        {
          "@type": "Question",
          name: "Is my location data private?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Your location is used only for prayer time calculations and never leaves your Mac.",
          },
        },
        {
          "@type": "Question",
          name: "Is there a free trial?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Download Waqtu and try it free on your Mac. After the trial, Premium comes from your Waqtu account: subscribe once (Rp 29.000/month or Rp 249.000/year) and it unlocks every device you sign in on.",
          },
        },
        {
          "@type": "Question",
          name: "How do I subscribe, and how do refunds work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Waqtu Premium is sold in the App Store (iPhone), Google Play (Android) and the Mac App Store edition of Waqtu. The website does not sell anything. Billing, cancelling and refunds are handled by Apple or Google under their store rules.",
          },
        },
        {
          "@type": "Question",
          name: "How is Waqtu different from other prayer apps?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Waqtu is the only native Mac app that combines menu bar prayer countdown with automatic calendar blocking. Other apps show prayer times — Waqtu also ensures your colleagues see you as busy during prayers, directly in Teams and Outlook.",
          },
        },
        {
          "@type": "Question",
          name: "Does Waqtu support different prayer calculation methods?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Waqtu supports multiple calculation methods including MWL, ISNA, Egyptian General Authority, and Umm al-Qura. You can also adjust the Asr calculation for Hanafi or Shafi'i madhab.",
          },
        },
        {
          "@type": "Question",
          name: "Can I match Waqtu to my local mosque times?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. You can add a custom time offset for each prayer to match your local mosque schedule. This ensures your calendar blocks and reminders align with your congregation.",
          },
        },
      ],
    },
    { "@type": "WebSite", name: "Waqtu", url: "https://getwaqtu.com" },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
