---
import BaseLayout from "../layouts/BaseLayout.astro";
import BackLink from "../components/BackLink.astro";

const today = new Date("2026-10-24").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="Privacy Policy — Waqtu" description="Privacy policy for the Waqtu prayer times apps for Mac, iOS and Android, and the Waqtu waitlist." canonical="/privacy">
  <div class="relative z-10 min-h-screen px-6 py-16 sm:px-10 md:px-14 md:py-24">
    <div class="mx-auto max-w-3xl">
      <BackLink href="/" label="Back to Waqtu" />
      <h1 class="font-display mb-8 text-3xl font-semibold tracking-tight text-[var(--waqtu-text)] sm:text-4xl">Privacy Policy</h1>

      <div class="prose-waqtu">
        <p class="text-[var(--waqtu-text)]">Last updated: {today}</p>

        <section>
          <h2>Information We Collect</h2>
          <p>Waqtu is designed to respect your privacy. We collect minimal information necessary to provide the prayer times service:</p>
          <ul>
            <li><strong>Location Data</strong> — Used solely for calculating accurate prayer times. Processed locally on your device and never transmitted to our servers.</li>
            <li><strong>Email Address</strong> — Collected when you purchase a license. Used for payment processing and license delivery.</li>
            <li><strong>Waitlist Signup</strong> — If you join the iOS and Android waitlist, we store your email address and, if you fill them in, your device type, your city, and the page language. We use them only to tell you about the Waqtu release. Your IP address is not stored; a salted hash of it is kept for at most 20 minutes to limit repeated sign-ups.</li>
            <li><strong>License Information</strong> — Stored to validate your purchase and provide updates.</li>
          </ul>
        </section>

        <section>
          <h2>Information We Don't Collect</h2>
          <p>We do NOT collect:</p>
          <ul>
            <li>Personal identification beyond what you voluntarily provide</li>
            <li>Usage analytics or tracking</li>
            <li>Device fingerprinting</li>
            <li>Prayer attendance or religious practice data</li>
            <li>Calendar event content or details</li>
          </ul>
        </section>

        <section>
          <h2>How Your Information Is Used</h2>
          <ul>
            <li>To calculate and display accurate prayer times based on your location</li>
            <li>To process payments and deliver lifetime licenses</li>
            <li>To provide app updates and bug fixes</li>
            <li>To respond to your support inquiries</li>
          </ul>
        </section>

        <section>
          <h2>Data Storage &amp; Security</h2>
          <ul>
            <li>Your location data never leaves your device</li>
            <li>Email and license information are stored securely and used only for essential purposes</li>
            <li>We use industry-standard payment processors (Polar) and do not store your payment details</li>
            <li>We do not sell, rent, or share your personal data with third parties</li>
          </ul>
        </section>

        <section>
          <h2>Data Retention</h2>
          <p>You may request deletion of your email and license information at any time by contacting us at <a href="mailto:dzulfikar.at@gmail.com">dzulfikar.at@gmail.com</a>. We will respond within 30 days.</p>
          <p>You can ask us to remove your waitlist entry the same way, by emailing <a href="mailto:dzulfikar.at@gmail.com">dzulfikar.at@gmail.com</a>.</p>
        </section>

        <section>
          <h2>Children's Privacy</h2>
          <p>Waqtu is not directed to children under 13. We do not knowingly collect personal information from children under 13.</p>
        </section>

        <section>
          <h2>Changes to This Policy</h2>
          <p>We may update this privacy policy from time to time. The updated version will be posted on this page with a revised &quot;Last updated&quot; date.</p>
        </section>

        <section>
          <h2>Contact Us</h2>
          <p>If you have questions about this privacy policy or how we handle your data, please contact us at <a href="mailto:dzulfikar.at@gmail.com">dzulfikar.at@gmail.com</a>.</p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
