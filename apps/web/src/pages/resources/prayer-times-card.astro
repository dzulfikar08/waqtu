---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";

const title = "Prayer Times Card — Waqtu Resources";
const description =
  "Create a printable prayer times card to share with colleagues. Shows your typical prayer windows so your team knows when you're unavailable.";

const prayers = [
  { prayer: "Fajr", time: "Before work hours", note: "Typically before 7 AM" },
  { prayer: "Dhuhr", time: "12:30 PM – 1:30 PM", note: "15-minute break" },
  { prayer: "Asr", time: "4:00 PM – 5:00 PM", note: "15-minute break" },
  { prayer: "Maghrib", time: "Sunset (~6:30 PM)", note: "Varies by season" },
  { prayer: "Isha", time: "After work hours", note: "Typically after 8 PM" },
];
---

<BaseLayout title={title} description={description} canonical="/resources/prayer-times-card" ogTitle={title} ogDescription={description}>
  <div class="relative z-10 min-h-screen px-6 py-16 sm:px-10 md:px-14 md:py-24">
    <div class="mx-auto max-w-3xl">
      <BackLink href="/resources" label="Back to Resources" />

      <h1 class="font-display mb-4 text-3xl font-semibold tracking-tight text-[var(--waqtu-text)] sm:text-4xl">Prayer Times Card</h1>
      <p class="mb-10 max-w-2xl text-[var(--waqtu-muted)] leading-relaxed">
        A simple, printable card showing your typical prayer windows. Keep it at your desk or share it with colleagues so they know when you&apos;re unavailable for meetings.
      </p>

      <div class="neu-card p-8 mb-8">
        <div class="text-center mb-6">
          <h2 class="font-display text-xl font-semibold text-[var(--waqtu-text)]">My Prayer Schedule</h2>
          <p class="mt-1 text-sm text-[var(--waqtu-muted)]">I&apos;ll be away briefly during these prayer windows.</p>
        </div>
        <div class="space-y-3">
          {prayers.map((p) => (
            <div class="flex items-center gap-4 p-3 rounded-lg bg-[var(--waqtu-bg)]">
              <span class="font-medium text-[var(--waqtu-gold)] w-20 text-sm">{p.prayer}</span>
              <span class="flex-1 text-sm text-[var(--waqtu-text)]">{p.time}</span>
              <span class="text-xs text-[var(--waqtu-muted)]">{p.note}</span>
            </div>
          ))}
        </div>
        <p class="mt-6 text-center text-xs text-[var(--waqtu-muted)]">Times are approximate and shift slightly each day. Calendar blocks are accurate. Questions? Just ask!</p>
      </div>

      <div class="neu-card p-8">
        <h2 class="font-display mb-4 text-xl font-semibold text-[var(--waqtu-text)]">How to use this</h2>
        <ol class="space-y-4 text-sm text-[var(--waqtu-muted)] list-decimal ml-6">
          <li><strong class="text-[var(--waqtu-text)]">Customize the times</strong> — Update the prayer windows to match your location and the current season. Use Waqtu to see exact times.</li>
          <li><strong class="text-[var(--waqtu-text)]">Print or screenshot</strong> — Keep a copy at your desk or share it digitally with your team.</li>
          <li><strong class="text-[var(--waqtu-text)]">Set up calendar blocking</strong> — For the most reliable approach, use Waqtu&apos;s calendar protection to automatically block your calendar. The card is a friendly supplement, not a replacement.</li>
          <li><strong class="text-[var(--waqtu-text)]">Keep it casual</strong> — This isn&apos;t a formal document. It&apos;s just a helpful reference so colleagues know when to avoid scheduling meetings.</li>
        </ol>
      </div>

      <div class="mt-8 text-center">
        <a href="/#download" class="neu-btn inline-flex items-center gap-2 px-6 py-3 font-medium text-[var(--waqtu-bg)]">
          Download Waqtu for automatic calendar blocking
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
