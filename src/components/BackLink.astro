---
interface Props {
  href?: string;
  label?: string;
}
const { href = "/", label = "Back to Waqtu" } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-2 text-sm text-[var(--waqtu-muted)] hover:text-[var(--waqtu-text)] transition-colors mb-8"
>
  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
  </svg>
  {label}
</a>
